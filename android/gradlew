#!/bin/sh

# Gradle start-up script for POSIX shells.

app_path=$0
while [ -h "$app_path" ]; do
    ls=$(ls -ld "$app_path")
    link=${ls#*' -> '}
    case $link in
        /*) app_path=$link ;;
        *) app_path=${app_path%/*}/$link ;;
    esac
done

APP_HOME=$(cd -P "${app_path%/*}" >/dev/null 2>&1 && pwd) || exit 1
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ -n "$JAVA_HOME" ]; then
    JAVACMD=$JAVA_HOME/bin/java
    if [ ! -x "$JAVACMD" ]; then
        echo "ERROR: JAVA_HOME does not point to a valid JDK: $JAVA_HOME" >&2
        exit 1
    fi
else
    JAVACMD=java
    command -v "$JAVACMD" >/dev/null 2>&1 || {
        echo "ERROR: JAVA_HOME is not set and java is not available on PATH." >&2
        exit 1
    }
fi

exec "$JAVACMD" \
    "-Dorg.gradle.appname=gradlew" \
    -classpath "$CLASSPATH" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
