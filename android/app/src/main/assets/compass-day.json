{
  "version": 8,
  "name": "Compass Day",
  "metadata": {
    "compass:theme": "day",
    "compass:purpose": "low-noise-driving"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#f5f3ed"}
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {"fill-color": "#dce8d5", "fill-opacity": 0.72}
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {"fill-color": "#dcebd4", "fill-opacity": 0.82}
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": {"fill-color": "#ebe9e4", "fill-opacity": 0.72}
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "commercial", "industrial"],
      "paint": {"fill-color": "#e8e3df", "fill-opacity": 0.72}
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {"fill-color": "#b9dbe8"}
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {"line-color": "#9bcddd", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.5, 14, 2.0]}
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", ["has", "admin_level"], ["<=", "admin_level", 4]],
      "paint": {"line-color": "#a7a4a0", "line-dasharray": [3, 2], "line-width": 0.8}
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {"fill-color": "#d7d4ce", "fill-outline-color": "#c6c2bb", "fill-opacity": 0.78}
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "path", "track"],
      "paint": {"line-color": "#d2cec6", "line-dasharray": [2, 1.5], "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 17, 2.0]}
    },
    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service"],
      "minzoom": 11,
      "paint": {"line-color": "#cfcbc4", "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.6, 16, 5.0, 19, 12.0]}
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service"],
      "minzoom": 11,
      "paint": {"line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.3, 16, 3.7, 19, 10.2]}
    },
    {
      "id": "road-secondary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {"line-color": "#c9c4bb", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.8, 14, 4.0, 18, 14.0]}
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {"line-color": "#fffdf9", "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.4, 14, 3.0, 18, 12.0]}
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {"line-color": "#c7b99f", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1.0, 14, 5.0, 18, 16.0]}
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {"line-color": "#f8e5b9", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 14, 3.8, 18, 13.8]}
    },
    {
      "id": "road-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {"line-color": "#b99f74", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.2, 12, 5.5, 17, 18.0]}
    },
    {
      "id": "road-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {"line-color": "#efc983", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.8, 12, 4.0, 17, 15.5]}
    },
    {
      "id": "road-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 11,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:it"], ["get", "name_it"], ["get", "name"], ["get", "name:latin"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 9, 16, 13],
        "text-letter-spacing": 0.02,
        "text-max-angle": 30
      },
      "paint": {"text-color": "#55534f", "text-halo-color": "#ffffff", "text-halo-width": 1.3}
    },
    {
      "id": "water-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "layout": {
        "text-field": ["coalesce", ["get", "name:it"], ["get", "name_it"], ["get", "name"], ["get", "name:latin"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11
      },
      "paint": {"text-color": "#477f93", "text-halo-color": "#e8f4f7", "text-halo-width": 1}
    },
    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "country", "state", "city", "town", "village", "suburb"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:it"], ["get", "name_it"], ["get", "name"], ["get", "name:latin"], ["get", "name_en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 12, 15],
        "text-max-width": 8
      },
      "paint": {"text-color": "#383735", "text-halo-color": "#f5f3ed", "text-halo-width": 1.4}
    }
  ]
}
