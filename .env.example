# Copy to .env for Docker Compose development. Do not commit real secrets.
POSTGRES_DB=compass
POSTGRES_USER=compass
POSTGRES_PASSWORD=change-me-for-any-shared-environment
DATABASE_URL=postgresql+psycopg://compass:change-me-for-any-shared-environment@db:5432/compass
COMPASS_IMAGE=compass-app:0.1.0

LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=180
MIMIT_STATIONS_URL=https://www.mimit.gov.it/images/exportCSV/anagrafica_impianti_attivi.csv
MIMIT_PRICES_URL=https://www.mimit.gov.it/images/exportCSV/prezzo_alle_8.csv
MIMIT_MAX_DOWNLOAD_BYTES=52428800
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_AREA_ISO3166_1=IT
OVERPASS_MAX_DOWNLOAD_BYTES=104857600
HTTP_USER_AGENT=compass-cng/0.1.0 (set-an-operator-contact)

# Phase 3 routing runtime. The official image is pinned by version and manifest digest.
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:3.8.3@sha256:24ef7955899dececb94e26c6dfb89d64fabfae875f980432694b0261eb6c251b
VALHALLA_TILE_URLS=https://download.geofabrik.de/europe/italy-latest.osm.pbf
VALHALLA_URL=http://valhalla:8002
VALHALLA_VOLUME_NAME=compass_valhalla_data
VALHALLA_THREADS=2
VALHALLA_FORCE_REBUILD=False
VALHALLA_CONNECT_TIMEOUT_SECONDS=5
VALHALLA_READ_TIMEOUT_SECONDS=60
VALHALLA_ROUTE_LANGUAGE=it-IT

# Phase 4 autonomy-aware spatial prefilter. Distances are kilometres.
CNG_CORRIDOR_RANGE_FRACTION=0.20
CNG_CORRIDOR_MINIMUM_RADIUS_KM=5
CNG_CORRIDOR_MAXIMUM_RADIUS_KM=50
CNG_CORRIDOR_CANDIDATE_LIMIT=200
ROUTE_GEOMETRY_MAX_POINTS=200000

# Phase 2 deterministic MIMIT-to-OSM reconciliation policy.
RECONCILIATION_MAX_DISTANCE_METERS=250
RECONCILIATION_AUTO_MATCH_DISTANCE_METERS=50
RECONCILIATION_NAMED_MATCH_DISTANCE_METERS=150
RECONCILIATION_NAME_SIMILARITY_THRESHOLD=0.75
RECONCILIATION_AMBIGUITY_SCORE_MARGIN=0.08
