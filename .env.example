# Copy to .env for Docker Compose development. Do not commit real secrets.
POSTGRES_DB=compass
POSTGRES_USER=compass
POSTGRES_PASSWORD=change-me-for-any-shared-environment
DATABASE_URL=postgresql+psycopg://compass:change-me-for-any-shared-environment@db:5432/compass
COMPASS_IMAGE=compass-app:0.1.0
COMPASS_TRAFFIC_IMAGE=compass-traffic-updater:0.1.0

LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=180
MIMIT_STATIONS_URL=https://www.mimit.gov.it/images/exportCSV/anagrafica_impianti_attivi.csv
MIMIT_PRICES_URL=https://www.mimit.gov.it/images/exportCSV/prezzo_alle_8.csv
MIMIT_MAX_DOWNLOAD_BYTES=52428800
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_AREA_ISO3166_1=IT
OVERPASS_MAX_DOWNLOAD_BYTES=104857600
HTTP_USER_AGENT=compass-cng/0.1.0 (set-an-operator-contact)

# Phase 3 routing runtime. The official image is pinned by version and manifest digest.
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:3.8.3@sha256:24ef7955899dececb94e26c6dfb89d64fabfae875f980432694b0261eb6c251b
VALHALLA_TILE_URLS=https://download.geofabrik.de/europe/italy-latest.osm.pbf
VALHALLA_URL=http://valhalla:8002
VALHALLA_VOLUME_NAME=compass_valhalla_data
VALHALLA_THREADS=2
VALHALLA_FORCE_REBUILD=False
VALHALLA_CONNECT_TIMEOUT_SECONDS=5
VALHALLA_READ_TIMEOUT_SECONDS=60
VALHALLA_ROUTE_LANGUAGE=it-IT
# Phase 5 batches are asymmetric, so each request contains at most this many pairs.
VALHALLA_MATRIX_BATCH_SIZE=40

# Live-traffic subsystem. Disabled by default: Compass keeps Valhalla's normal
# speed hierarchy and does not send traffic-aware route requests until both
# TRAFFIC_ENABLED and TRAFFIC_VALHALLA_OVERLAY_ENABLED are true.
TRAFFIC_ENABLED=false
TRAFFIC_PROVIDER=none
# on_demand contacts the provider only for an actual route calculation. The
# legacy periodic mode remains available for deterministic diagnostics only.
TRAFFIC_REFRESH_MODE=on_demand
TRAFFIC_REFRESH_SECONDS=60
TRAFFIC_ROUTE_REFRESH_MIN_INTERVAL_SECONDS=300
TRAFFIC_ROUTE_PROBE_SPACING_KM=25
TRAFFIC_ROUTE_MAX_PROBES=16
TRAFFIC_ROUTE_REFRESH_TIMEOUT_SECONDS=45
TRAFFIC_UPDATER_URL=http://traffic-updater:8003
TRAFFIC_REFRESH_LEDGER_PATH=/custom_files/compass_traffic_state/route_refresh.json
# This sweep only resets expired local TrafficSpeed records; it never calls TomTom.
TRAFFIC_EXPIRY_SWEEP_SECONDS=30
TRAFFIC_UPDATE_SEGMENT_LIMIT=1000
TRAFFIC_MAX_AGE_SECONDS=300
TRAFFIC_MIN_CONFIDENCE=0.50
TRAFFIC_MIN_MATCH_CONFIDENCE=0.75
TRAFFIC_MATCH_SEARCH_RADIUS_METERS=75
TRAFFIC_MATCH_GPS_ACCURACY_METERS=15
TRAFFIC_OPENLR_DECODER_PATH=/usr/local/bin/compass-valhalla-traffic-tool
TRAFFIC_OPENLR_DECODER_TIMEOUT_SECONDS=2
TRAFFIC_OPENLR_ENDPOINT_TOLERANCE_METERS=300
TRAFFIC_WRITER_TIMEOUT_SECONDS=60
TRAFFIC_MAX_SPEED_KPH=180
TRAFFIC_VALHALLA_OVERLAY_ENABLED=false
# Set this to the exact identity printed by the activation preflight. Never
# copy it across a Valhalla tile rebuild: routing tiles and traffic.tar are a matched set.
TRAFFIC_VALHALLA_TILESET_VERSION=
# Production geometry/OpenLR matching currently uses valhalla-openlr-geometry-v1.
TRAFFIC_MAPPING_VERSION=unbuilt
TRAFFIC_STATE_PATH=/custom_files/compass_traffic_state/state.json
TRAFFIC_HEALTH_PATH=/custom_files/compass_traffic_state/health.json
TRAFFIC_MOCK_FIXTURE_PATH=
# Current TomTom implementation targets the base Traffic Flow API
# flowSegmentData endpoint. In on-demand mode probes are sampled from the
# requested route. TOMTOM_FLOW_SEGMENT_POINTS is only a CLI/debug fallback.
# Intermediate JSON support remains for future bulk/feed fixtures.
TOMTOM_TRAFFIC_API_MODE=flow_segment
TOMTOM_TRAFFIC_URL=
TOMTOM_FLOW_SEGMENT_POINTS=
TOMTOM_FLOW_SEGMENT_STYLE=absolute
TOMTOM_FLOW_SEGMENT_ZOOM=10
TOMTOM_FLOW_SEGMENT_UNIT=kmph
TOMTOM_FLOW_SEGMENT_OPENLR=true
TOMTOM_API_KEY=
TOMTOM_TIMEOUT_SECONDS=20
TOMTOM_MAX_RETRIES=3
TOMTOM_MAX_CONCURRENCY=2
TOMTOM_BACKOFF_BASE_SECONDS=0.5

# Phase 4 autonomy-aware spatial prefilter. Distances are kilometres.
CNG_CORRIDOR_RANGE_FRACTION=0.20
CNG_CORRIDOR_MINIMUM_RADIUS_KM=5
CNG_CORRIDOR_MAXIMUM_RADIUS_KM=50
CNG_CORRIDOR_CANDIDATE_LIMIT=200
ROUTE_GEOMETRY_MAX_POINTS=200000

# Phase 6 arrival-time availability and explainable ranking policy.
OPENING_HOURS_TIMEZONE=Europe/Rome
CNG_RANKING_DETOUR_WEIGHT=0.50
CNG_RANKING_OPENING_WEIGHT=0.25
CNG_RANKING_PRICE_WEIGHT=0.15
CNG_RANKING_PRICE_FRESHNESS_WEIGHT=0.10
CNG_RANKING_UNKNOWN_OPENING_SCORE=0.25
CNG_RANKING_CLOSED_SCORE_MULTIPLIER=0.25
CNG_PRICE_FRESHNESS_HOURS=168

# Phase 7 operational data-freshness thresholds. Stale data degrades readiness
# metadata but remains queryable; missing required normalized data returns 503.
MIMIT_DATA_FRESHNESS_HOURS=48
OSM_DATA_FRESHNESS_HOURS=168
RECONCILIATION_DATA_FRESHNESS_HOURS=48

# Phase 2 deterministic MIMIT-to-OSM reconciliation policy.
RECONCILIATION_MAX_DISTANCE_METERS=250
RECONCILIATION_AUTO_MATCH_DISTANCE_METERS=50
RECONCILIATION_NAMED_MATCH_DISTANCE_METERS=150
RECONCILIATION_NAME_SIMILARITY_THRESHOLD=0.75
RECONCILIATION_AMBIGUITY_SCORE_MARGIN=0.08
